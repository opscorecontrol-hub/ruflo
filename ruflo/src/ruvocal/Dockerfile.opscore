# syntax=docker/dockerfile:1
# OpsCore patched Dockerfile for ruflo-chat-ui
# Identical to Dockerfile but starts a mock OpenAI models server during build
# so npm run build doesn't crash when OPENAI_BASE_URL is unreachable at build time.

ARG INCLUDE_DB=false

FROM node:24-slim AS base

RUN npm install -g dotenv-cli
RUN userdel -r node 2>/dev/null; useradd -m -u 1000 user
USER user

ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

WORKDIR /app
RUN touch /app/.env.local

USER root
RUN apt-get update && apt-get install -y libgomp1 libcurl4 curl dnsutils nano
RUN mkdir -p /home/user/.npm && chown -R 1000:1000 /home/user/.npm
USER user

COPY --chown=1000 .env /app/.env
RUN sed -i 's/^MODELS=$/# MODELS=/' /app/.env && \
    sed -i 's/^TASK_MODEL=$/# TASK_MODEL=/' /app/.env
COPY --chown=1000 entrypoint.sh /app/entrypoint.sh
COPY --chown=1000 package.json /app/package.json
COPY --chown=1000 package-lock.json /app/package-lock.json

RUN chmod +x /app/entrypoint.sh

FROM node:24 AS builder

WORKDIR /app

COPY --link --chown=1000 package-lock.json package.json ./

ARG APP_BASE=
ARG PUBLIC_APP_COLOR=
ENV BODY_SIZE_LIMIT=15728640

RUN --mount=type=cache,target=/app/.npm \
    npm set cache /app/.npm && \
    npm ci

COPY --link --chown=1000 . .

# Start a mock OpenAI-compatible server so npm run build does not crash when
# it tries to fetch the models list from OPENAI_BASE_URL at build time.
RUN node -e "require('http').createServer(function(q,s){s.setHeader('Content-Type','application/json');s.end(JSON.stringify({object:'list',data:[]}));}).listen(3001,'127.0.0.1');" & \
    sleep 2 && \
    git config --global --add safe.directory /app && \
    npm run build

FROM mongo:7 AS mongo

FROM base AS local_db_false

FROM base AS local_db_true

COPY --from=mongo /usr/bin/mongo* /usr/bin/

ENV MONGODB_URL=mongodb://localhost:27017
USER root
RUN mkdir -p /data/db && chown -R 1000:1000 /data/db
USER user

FROM local_db_${INCLUDE_DB} AS final

ARG INCLUDE_DB=false
ENV INCLUDE_DB=${INCLUDE_DB}

ARG APP_BASE=
ARG PUBLIC_APP_COLOR=
ARG PUBLIC_COMMIT_SHA=
ENV PUBLIC_COMMIT_SHA=${PUBLIC_COMMIT_SHA}
ENV BODY_SIZE_LIMIT=15728640

COPY --from=builder --chown=1000 /app/build /app/build
COPY --from=builder --chown=1000 /app/node_modules /app/node_modules

CMD ["/bin/bash", "-c", "/app/entrypoint.sh"]
