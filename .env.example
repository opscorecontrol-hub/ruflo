# ── OpsCore / Blackbird 2030 ──────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-64-char-random-string

# VM Provider: 'local' (mock, no API calls) or 'hetzner' (real Hetzner Cloud API)
VM_PROVIDER=local

# Required only when VM_PROVIDER=hetzner
HCLOUD_TOKEN=

# Scaling thresholds (optional overrides)
AGENT_DENSITY_THRESHOLD=10
HIGH_LOAD_THRESHOLD=80
LOW_LOAD_THRESHOLD=20
QUEUE_DEPTH_THRESHOLD=50

# ── AI Provider Keys (for Ruflo MCP bridge) ───────────────────────────────────
# At least one required for agent tool calls
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Ruflo Chat UI ─────────────────────────────────────────────────────────────
MONGODB_DB_NAME=chat-db
BRAND_NAME=RuFlo
BRAND_DESCRIPTION=Enterprise AI Agent Orchestration Platform

# ── SSL (optional — run certbot after initial deploy) ─────────────────────────
OPSCORE_DOMAIN=yourdomain.com
CERT_EMAIL=admin@yourdomain.com

# ── Ruflo MCP Bridge Groups (defaults) ───────────────────────────────────────
# Set to "false" to disable a group
MCP_GROUP_SECURITY=false
